{
  "name": "ansiudad",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b"
  }
}
